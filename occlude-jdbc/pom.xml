<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.occlude</groupId>
    <artifactId>occlude-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>occlude-jdbc</artifactId>
  <name>Occlude :: JDBC</name>
  <description>Durable storage: encrypted payloads, lineage, and erasure by reachability.</description>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.occlude</groupId>
      <artifactId>occlude-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Only the codec contract. Which serialisation, which compression and which encryption are
         the application's to choose and compose; this module just applies what it is handed. -->
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-jackson</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Every payload is envelope-encrypted, and the pipeline is versioned so it can change without
         rewriting what is stored. The cryptography is codec's; this module has none of its own. -->
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-versioned</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
