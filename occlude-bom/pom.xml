<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    This module deliberately has NO <parent>.

    Importing a BOM pulls in its *effective* dependencyManagement, after inheritance.
    occlude-parent imports spring-boot-dependencies, junit-bom, codec-bom and testcontainers-bom
    for its own build, so inheriting from it made this BOM re-export all of them: 1934 managed
    entries, 5 of them Occlude's. A consumer importing it to align Occlude's artifacts would have
    had its Spring Boot, Netty and Testcontainers versions decided for it too.

    codec-bom, substrate-bom and nessy-bom were each fixed this way for the same reason, and
    junit-bom and spring-boot-dependencies are parentless too. Everything the parent used to
    supply is therefore declared here: coordinates, licence, developer, scm, and the formatting
    and licence plugins. If the parent gains a release profile, this module needs its own, and
    a release that runs versions:set needs -DprocessAllModules=true, or this module is left on
    its -SNAPSHOT version while the rest move.
  -->
  <groupId>org.jwcarman.occlude</groupId>
  <artifactId>occlude-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Occlude :: BOM</name>
  <description>Bill of Materials for Occlude — version alignment for consumers</description>
  <url>https://github.com/jwcarman/occlude</url>
  <inceptionYear>2026</inceptionYear>

  <developers>
    <developer>
      <id>jwcarman</id>
      <name>James Carman</name>
    </developer>
  </developers>

  <licenses>
    <license>
      <name>Apache 2</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>A business-friendly OSS license</comments>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/jwcarman/occlude</url>
    <connection>scm:git:git@github.com:jwcarman/occlude.git</connection>
    <developerConnection>scm:git:git@github.com:jwcarman/occlude.git</developerConnection>
  </scm>

  <dependencyManagement>
    <dependencies>
      <!-- Every artifact an application depends on directly. The example is not here: it is a
           demonstration rather than something to build against. Nothing a consumer chooses for
           itself belongs here either. Which serialisation, which compression and which encryption
           are the application's decisions, so pinning a codec here would be this library quietly
           taking one of them back. -->
      <dependency>
        <groupId>org.jwcarman.occlude</groupId>
        <artifactId>occlude-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.occlude</groupId>
        <artifactId>occlude-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.occlude</groupId>
        <artifactId>occlude-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.occlude</groupId>
        <artifactId>occlude-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.occlude</groupId>
        <artifactId>occlude-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Formatting and licence checks, which would otherwise have come from the parent this module
       cannot have. CI runs `spotless:check license:check` at the reactor root, and without them
       that fails here on an unresolvable goal prefix rather than on a real finding. Versions
       match occlude-parent's. -->
  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.2</version>
      </plugin>
      <plugin>
        <groupId>com.mycila</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>5.1.2</version>
        <configuration>
          <properties>
            <owner>James Carman</owner>
          </properties>
          <licenseSets>
            <licenseSet>
              <inlineHeader><![CDATA[Copyright © ${year} ${owner}

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

    http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.]]></inlineHeader>
              <includes>
                <include>pom.xml</include>
              </includes>
            </licenseSet>
          </licenseSets>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
