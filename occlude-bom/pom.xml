<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jwcarman.occlude</groupId>
    <artifactId>occlude-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>occlude-bom</artifactId>
  <packaging>pom</packaging>
  <name>Occlude :: BOM</name>
  <description>Bill of Materials for Occlude — version alignment for consumers</description>

  <dependencyManagement>
    <dependencies>
      <!-- Every artifact an application depends on directly. The example is not here: it is a
           demonstration rather than something to build against. Nothing a consumer chooses for
           itself belongs here either. Which serialisation, which compression and which encryption
           are the application's decisions, so pinning a codec here would be this library quietly
           taking one of them back. -->
      <dependency>
        <groupId>org.jwcarman.occlude</groupId>
        <artifactId>occlude-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.occlude</groupId>
        <artifactId>occlude-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.occlude</groupId>
        <artifactId>occlude-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.occlude</groupId>
        <artifactId>occlude-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.occlude</groupId>
        <artifactId>occlude-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- The one exception to the rule above. Spring Boot 4.1.1 manages Jackson 3.1.5, and
           jackson-databind below 3.1.6 has CVE-2026-68497, CVE-2026-83557 and CVE-2026-19032. A
           scanner reports those against Occlude when Occlude's BOM brings them, so the BOM pins a
           fixed version. An application can still override it. Drop this with the jackson.version
           pin in occlude-parent, once Boot manages a fixed version. -->
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    Flattened on the way out, and only this module is.

    Importing a BOM pulls in its *effective* dependencyManagement, after inheritance, and
    occlude-parent imports spring-boot-dependencies, junit-bom, codec-bom and testcontainers-bom
    for its own build. Published as-is, this BOM re-exported all of them: 1934 managed entries, 5
    of them Occlude's, so a consumer aligning Occlude's artifacts had its Spring Boot, Netty and
    Testcontainers versions decided too.

    bom mode writes the pom that is installed and deployed without the parent and with only the
    dependencyManagement declared here. The build still inherits normally, so versions:set, the
    sonar: prefix and the formatting and licence checks all reach this module like any other.
    langchain4j-bom is set up the same way.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <flattenMode>bom</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
