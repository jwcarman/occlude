<project child.project.url.inherit.append.path="false"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.jwcarman.occlude</groupId>
  <artifactId>occlude-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Occlude</name>
  <description>A governed claim check for Java: a token travels instead of the payload, and
    redeeming it is decided against the value's label, the sink's ceiling, and an identity
    the holder of the token does not control.</description>
  <url>https://github.com/jwcarman/occlude</url>
  <inceptionYear>2026</inceptionYear>

  <developers>
    <developer>
      <id>jwcarman</id>
      <name>James Carman</name>
    </developer>
  </developers>

  <licenses>
    <license>
      <name>Apache 2</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>A business-friendly OSS license</comments>
    </license>
  </licenses>

  <!-- Not appended to per module: github.com/jwcarman/occlude/occlude-core is not a page. -->
  <scm child.scm.url.inherit.append.path="false"
       child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false">
    <url>https://github.com/jwcarman/occlude</url>
    <connection>scm:git:git@github.com:jwcarman/occlude.git</connection>
    <developerConnection>scm:git:git@github.com:jwcarman/occlude.git</developerConnection>
  </scm>

  <modules>
    <module>occlude-bom</module>
    <module>occlude-api</module>
    <module>occlude-core</module>
    <module>occlude-jdbc</module>
    <module>occlude-spring-boot-autoconfigure</module>
    <module>occlude-spring-boot-starter</module>
    <module>occlude-example</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <junit.version>6.1.3</junit.version>
    <jug.version>5.2.0</jug.version>
    <assertj.version>3.27.7</assertj.version>

    <codec.version>0.10.0</codec.version>
    <spring-boot.version>4.1.1</spring-boot.version>
    <postgresql.version>42.7.13</postgresql.version>
    <testcontainers.version>2.0.5</testcontainers.version>

    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
    <spotless.version>3.10.2</spotless.version>
    <license.plugin.version>5.1.2</license.plugin.version>
    <license.owner>James Carman</license.owner>

    <jacoco.version>0.8.15</jacoco.version>
    <sonar.plugin.version>5.7.0.6970</sonar.plugin.version>

    <!-- Set by the jacoco prepare-agent execution in the ci profile, and empty otherwise so that
         surefire's argLine resolves to nothing rather than to a literal when jacoco is not on. -->
    <jacocoArgLine></jacocoArgLine>

    <sonar.organization>jwcarman</sonar.organization>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.projectKey>jwcarman_occlude</sonar.projectKey>

    <!-- The example is a demonstration of the library rather than part of it. Analysing it reports
         on how a sample application is written, which is nobody's quality gate. -->
    <sonar.exclusions>occlude-example/**</sonar.exclusions>

    <sonar.coverage.exclusions>occlude-example/**</sonar.coverage.exclusions>

    <!-- Each module's own report, and no aggregator. A module's number is then about the tests
         that module has, which is the thing worth holding it to. The cost is that coverage does
         not cross a module boundary: code exercised only from another module's tests reads as
         uncovered, and the answer to that is a test where the code lives. -->
    <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/*/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.uuid</groupId>
        <artifactId>java-uuid-generator</artifactId>
        <version>${jug.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.codec</groupId>
        <artifactId>codec-bom</artifactId>
        <version>${codec.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <!-- Version only. occlude-bom is the one module that binds it; see its pom for why. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>${flatten-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Parameter names are kept in the bytecode. Spring resolves @PathVariable and friends by
           name, and without this every such endpoint fails at runtime rather than at compile time.
           spring-boot-starter-parent sets it; this build has its own parent, so it says it here.
           Every lint category is on, so a new warning shows up in the build rather than in Sonar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{jacocoArgLine}</argLine>
        </configuration>
      </plugin>

      <!-- Declared so that `sonar:sonar` resolves. The goal only runs in CI, where a token
           exists; the plugin has to be findable either way. -->
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>${sonar.plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <style>GOOGLE</style>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Every source file carries the Apache header, checked in `validate` beside the
           formatting: both are what the code should look like, and neither is worth finding out
           about after a compile. `license:format` writes the missing ones. -->
      <plugin>
        <groupId>com.mycila</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>${license.plugin.version}</version>
        <configuration>
          <properties>
            <owner>${license.owner}</owner>
          </properties>
          <licenseSets>
            <licenseSet>
              <inlineHeader><![CDATA[Copyright © ${year} ${owner}

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

    http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.]]></inlineHeader>
              <excludes>
                <exclude>**/README</exclude>
                <exclude>site/**</exclude>
                <exclude>**/README.md</exclude>
                <exclude>**/*.md</exclude>
                <exclude>src/test/resources/**</exclude>
                <exclude>src/main/resources/**</exclude>
                <exclude>.mvn/**</exclude>
                <exclude>mvnw</exclude>
                <exclude>LICENSE</exclude>
              </excludes>
            </licenseSet>
          </licenseSets>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Coverage is measured in CI, where the report is consumed. Locally it is a slower build
         for a number nobody reads. -->
    <profile>
      <id>ci</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <configuration>
              <propertyName>jacocoArgLine</propertyName>
            </configuration>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>report</id>
                <goals>
                  <goal>report</goal>
                </goals>
                <configuration>
                  <formats>
                    <format>XML</format>
                  </formats>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
