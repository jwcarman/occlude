<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot without spring-boot-starter-parent, which is Boot's own documented option for
       a module that already has a parent: import spring-boot-dependencies for versions, and
       declare spring-boot-maven-plugin with its repackage goal for the jar and for
       `mvn spring-boot:run`.

       Inheriting occlude-parent is the point. Formatting, licence headers, the compiler settings
       and the surefire configuration are the build this module is part of, and re-declaring them
       here was how they drifted. The `parameters` compiler flag that @PathVariable needs comes
       from occlude-parent, which sets it for the same reason Boot's parent does. -->
  <parent>
    <groupId>org.jwcarman.occlude</groupId>
    <artifactId>occlude-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <groupId>org.jwcarman.occlude</groupId>
  <artifactId>occlude-example</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Occlude :: Example</name>
  <description>A billing support desk: an ordinary Spring Boot service that happens to handle
    cardholder data and untrusted mail.</description>

  <dependencyManagement>
    <dependencies>
      <!-- Ahead of what Boot 4.1.1 manages (11.0.24), which carries three criticals: a FORM auth
           authorization flaw, a DIGEST capture-replay bypass, and an access-control flaw. This
           module is the only one here that serves HTTP, so no published artifact is exposed. A
           security library shipping a demo on a known-vulnerable server is still its own
           argument. Remove when Boot catches up.

           Declared rather than set through the tomcat.version property: an imported BOM resolves
           its own properties, so the property form would be silently inert now that this module
           imports spring-boot-dependencies instead of inheriting it. First declaration wins in
           dependencyManagement, which is why these sit above the import. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>11.0.25</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>11.0.25</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>11.0.25</version>
      </dependency>

      <!-- Again here, because this module imports spring-boot-dependencies itself and its own
           imports win over the parent's: without it, Jackson falls back to Boot's 3.1.5. See the
           jackson.version property in occlude-parent for the CVEs. -->
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jwcarman.codec</groupId>
        <artifactId>codec-bom</artifactId>
        <version>${codec.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.jwcarman.occlude</groupId>
      <artifactId>occlude-spring-boot-starter</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jwcarman.codec</groupId>
      <artifactId>codec-transforms</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- `mvn spring-boot:run` starts the compose file beside this pom and wires the datasource
         from it, so there is nothing to set up before running the service. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-docker-compose</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 moved TestRestTemplate into its own module, which needs RestTemplateBuilder from
         another. Tests use Testcontainers rather than the compose file: a test should bring its
         own database rather than expect one to be running. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- Version and goal stated explicitly: without spring-boot-starter-parent nothing
           supplies either, and the jar silently would not be repackaged. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

</plugins>
  </build>
</project>
